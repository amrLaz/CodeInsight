{
  "Authentication": {
    "Issuer": "CodeInsights",
    "Audience": "CodeInsights.Web",
    "SessionMinutes": 480,
    "LocalAccountsMode": "enabled",
    "AutoEntraSignIn": true
  },
  "Bootstrap": {
    "AdminEmail": "admin@codeinsights.local"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:5174"]
  },
  "Analysis": {
    "Enforcement": "informative"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}

