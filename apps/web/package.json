{
  "name": "codeinsights-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "tsc --noEmit --noUnusedLocals && npm run test:run",
