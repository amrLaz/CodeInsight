{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: prepare",
      "program": "${workspaceFolder}/apps/api/bin/Debug/net10.0/CodeInsights.Api.dll",
      "cwd": "${workspaceFolder}/apps/api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:8000",
        "Ingestion__BlobConnectionString": "UseDevelopmentStorage=true",
        "Ingestion__PlatformUrl": "http://127.0.0.1:5173"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Web (Vite + Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web: dev",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/apps/web"
    }
  ],
  "compounds": [
    {
      "name": "CodeInsights: API + Web",
      "configurations": ["API (.NET)", "Web (Vite + Chrome)"],
      "stopAll": true
    }
  ]
}
